{
  "version": 2,
  "comment": "Single source of truth for SPA page URLs. Read by Flask (page matcher + legacy redirects, spa_routes.py) and imported by the frontend route manifest (app/manifest.ts). A page path is a workspace path, optionally followed by one tab segment from its tabs list. redirectRules are tried in order BEFORE the exact-path redirects map and the first match wins: 'from' is a path pattern (':name' binds one segment; 'params' lists the values a ':name' may take), 'query' requires keys ('*' any value, a string, or a list of allowed values), the target is 'to' with ':name' substituted, and its query is the original pairs (order kept) after drop, then rename, then map (value per key), then prefix (value per key), then set (replace or append; ':name' substituted). Rule targets are form-encoded identically in Python and TypeScript (spa_redirect_cases.json pins both). Exact redirects append the original query untouched. No target is ever itself a redirect.",
  "workspaces": [
    { "id": "home", "label": "Home", "path": "/", "tabs": [] },
    { "id": "synthetic", "label": "Synthetic", "path": "/synthetic", "tabs": ["status", "records", "galaxies", "stars", "noise", "psf", "fields"], "defaultTab": "status" },
    { "id": "models", "label": "Models", "path": "/models/:mode", "params": { "mode": ["starfull", "starless"] }, "defaultParams": { "mode": "starfull" }, "tabs": ["leaderboard", "members", "train", "combiner", "diagnostics", "images"], "defaultTab": "leaderboard" },
    { "id": "sky", "label": "Sky", "path": "/sky", "tabs": ["atlas", "targets", "compare"], "defaultTab": "atlas" },
    { "id": "figures", "label": "Figures", "path": "/figures", "tabs": ["plates", "sheet", "studies"], "defaultTab": "plates" },
    { "id": "files", "label": "Files", "path": "/files", "tabs": [] },
    { "id": "runs", "label": "Runs", "path": "/runs", "tabs": ["live", "history", "steps"], "defaultTab": "live" },
    { "id": "notebook", "label": "Notebook", "path": "/notebook", "tabs": ["log", "backups", "sandboxes"], "defaultTab": "log" },
    { "id": "system", "label": "System", "path": "/system", "tabs": ["connections", "config", "lineage", "code", "storage", "appearance"], "defaultTab": "connections" }
  ],
  "redirectRules": [
    { "from": "/jwst-euclid", "to": "/sky/atlas", "set": { "obs": "1" } },

    { "from": "/sky/results", "query": { "source": "archive" }, "to": "/synthetic/fields", "drop": ["source"], "set": { "ref": "1" } },
    { "from": "/sky/results", "query": { "src": "archive" }, "to": "/synthetic/fields", "drop": ["src"], "set": { "ref": "1" } },
    { "from": "/sky/results", "query": { "diag": ["1", "true"], "fd": "occupancy" }, "to": "/models/starfull/diagnostics", "drop": ["diag", "fd", "source", "src", "state"], "set": { "d": "real-field" } },
    { "from": "/sky/results", "query": { "diag": ["1", "true"] }, "to": "/models/starfull/diagnostics", "drop": ["diag", "source", "src", "state"], "set": { "d": "real-field" } },
    { "from": "/sky/results", "query": { "source": "*" }, "to": "/sky/targets", "drop": ["diag"], "rename": { "source": "set" }, "map": { "set": { "tile": "cached", "field": "legacy", "eval": "lenses,galaxies", "pair": "pairs" } } },
    { "from": "/sky/results", "query": { "src": "*" }, "to": "/sky/targets", "drop": ["diag"], "rename": { "src": "set" }, "map": { "set": { "tile": "cached", "field": "legacy", "eval": "lenses,galaxies", "pair": "pairs" } } },
    { "from": "/sky/results", "to": "/sky/targets", "drop": ["diag"] },

    { "from": "/sky/catalog-eval", "query": { "figs": ["1", "true"] }, "to": "/models/starfull/diagnostics", "drop": ["figs", "g"], "set": { "d": "recovery" } },
    { "from": "/sky/catalog-eval", "query": { "g": ["syn-lens", "syn-gal", "syn-lens,syn-gal", "syn-gal,syn-lens"] }, "to": "/models/starfull/images", "set": { "set": "stamps" } },
    { "from": "/sky/catalog-eval", "query": { "g": ["A", "B", "C", "lensA", "lensB", "lensC"] }, "to": "/sky/targets", "map": { "g": { "lensA": "A", "lensB": "B", "lensC": "C" } }, "set": { "set": "lenses" } },
    { "from": "/sky/catalog-eval", "query": { "g": ["gal", "galaxies"] }, "to": "/sky/targets", "drop": ["g"], "set": { "set": "galaxies" } },
    { "from": "/sky/catalog-eval", "to": "/sky/targets", "set": { "set": "lenses,galaxies" } },
    { "from": "/evaluation", "to": "/sky/targets", "set": { "set": "lenses,galaxies" } },

    { "from": "/ensemble/:mode", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/leaderboard" },
    { "from": "/ensemble/:mode/overview", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/leaderboard" },
    { "from": "/ensemble/:mode/knee", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/leaderboard" },
    { "from": "/ensemble/:mode/members", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/members" },
    { "from": "/ensemble/:mode/curves", "params": { "mode": ["starfull", "starless"] }, "query": { "layout": "time" }, "to": "/runs/history", "drop": ["layout"], "set": { "step": "ensemble_train" } },
    { "from": "/ensemble/:mode/curves", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/members", "set": { "view": "curves" } },
    { "from": "/ensemble/:mode/train", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/train" },
    { "from": "/ensemble/:mode/diagnostics", "params": { "mode": ["starfull", "starless"] }, "query": { "d": ["stderr", "brightness", "calibration", "axes"] }, "to": "/models/:mode/diagnostics", "set": { "d": "spread" } },
    { "from": "/ensemble/:mode/diagnostics", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/diagnostics" },
    { "from": "/ensemble/:mode/combiners", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/combiner" },
    { "from": "/ensemble/:mode/disagreement", "params": { "mode": ["starfull", "starless"] }, "to": "/models/:mode/images" },

    { "from": "/realism/galaxies", "query": { "view": "model" }, "to": "/synthetic/galaxies", "drop": ["view"], "set": { "prior": "1" } },
    { "from": "/realism/galaxies", "query": { "view": "figure" }, "to": "/figures/plates", "drop": ["view"], "set": { "plate": "galaxies" } },
    { "from": "/realism/galaxies", "to": "/synthetic/galaxies" },
    { "from": "/realism/stars", "query": { "view": "prior" }, "to": "/synthetic/stars", "drop": ["view"], "set": { "prior": "1" } },
    { "from": "/realism/stars", "to": "/synthetic/stars", "drop": ["view"] },
    { "from": "/realism/pixels", "query": { "view": "census" }, "to": "/synthetic/records", "drop": ["view", "hide"], "set": { "section": "census" } },
    { "from": "/realism/pixels", "query": { "view": "inputs" }, "to": "/runs/steps", "drop": ["view", "hide", "training"], "set": { "stage": "noise-fields" } },
    { "from": "/realism/pixels", "query": { "view": "detection" }, "to": "/synthetic/fields" },
    { "from": "/realism/pixels", "to": "/synthetic/fields", "set": { "view": "stats" } },
    { "from": "/population-comparison", "to": "/synthetic/fields", "set": { "view": "stats" } },
    { "from": "/realism/visual", "to": "/synthetic/fields", "set": { "view": "look" } },
    { "from": "/synthetic-real", "to": "/synthetic/fields", "set": { "view": "look" } },

    { "from": "/data/catalog", "to": "/synthetic/psf", "set": { "view": "catalogue" } },
    { "from": "/catalog", "to": "/synthetic/psf", "set": { "view": "catalogue" } },
    { "from": "/data/cutouts", "to": "/synthetic/psf", "set": { "view": "cutouts" } },
    { "from": "/cutouts", "to": "/synthetic/psf", "set": { "view": "cutouts" } },
    { "from": "/cutouts/:band", "params": { "band": ["VIS", "Y_E", "J_E", "H_E"] }, "to": "/synthetic/psf", "set": { "view": "cutouts", "band": ":band" } },
    { "from": "/data/psfs", "to": "/synthetic/psf", "set": { "view": "epsf" } },
    { "from": "/psfs", "to": "/synthetic/psf", "set": { "view": "epsf" } },
    { "from": "/data/tng", "to": "/synthetic/galaxies", "set": { "view": "templates" } },
    { "from": "/tng", "to": "/synthetic/galaxies", "set": { "view": "templates" } },

    { "from": "/figures/results", "to": "/figures/sheet", "set": { "pool": "gallery" } },

    { "from": "/ops/jobs", "query": { "job": "*" }, "to": "/runs/history", "rename": { "job": "run" }, "prefix": { "run": "local:" } },
    { "from": "/ops/fasrc", "query": { "view": "steps" }, "to": "/runs/steps", "drop": ["view"] },
    { "from": "/ops/fasrc", "query": { "view": "history" }, "to": "/runs/history", "drop": ["view"] },
    { "from": "/ops/fasrc", "query": { "view": "logs" }, "to": "/runs/history", "drop": ["view"], "rename": { "job": "run" }, "set": { "logs": "1" } },
    { "from": "/ops/fasrc", "query": { "view": "storage" }, "to": "/system/storage", "drop": ["view"], "set": { "side": "fasrc" } },
    { "from": "/ops/fasrc", "query": { "view": "git" }, "to": "/system/code", "drop": ["view"], "set": { "side": "fasrc" } },
    { "from": "/ops/fasrc", "to": "/runs/live", "drop": ["view"] },
    { "from": "/fasrc", "query": { "view": "steps" }, "to": "/runs/steps", "drop": ["view"] },
    { "from": "/fasrc", "query": { "view": "history" }, "to": "/runs/history", "drop": ["view"] },
    { "from": "/fasrc", "query": { "view": "logs" }, "to": "/runs/history", "drop": ["view"], "rename": { "job": "run" }, "set": { "logs": "1" } },
    { "from": "/fasrc", "query": { "view": "storage" }, "to": "/system/storage", "drop": ["view"], "set": { "side": "fasrc" } },
    { "from": "/fasrc", "query": { "view": "git" }, "to": "/system/code", "drop": ["view"], "set": { "side": "fasrc" } },
    { "from": "/fasrc", "to": "/runs/live", "drop": ["view"] },

    { "from": "/ops/tracking", "query": { "view": "backups" }, "to": "/notebook/backups", "drop": ["view"] },
    { "from": "/ops/tracking", "query": { "view": "archive" }, "to": "/notebook/backups", "drop": ["view"], "set": { "show": "campaigns" } },
    { "from": "/ops/tracking", "query": { "view": "sandboxes" }, "to": "/notebook/sandboxes", "drop": ["view"] },
    { "from": "/ops/tracking", "query": { "view": "jobs", "jcamp": "*" }, "to": "/runs/history", "drop": ["view"], "rename": { "jcamp": "campaign" } },
    { "from": "/ops/tracking", "query": { "view": "jobs" }, "to": "/runs/history", "drop": ["view"], "set": { "campaign": "current" } },
    { "from": "/ops/tracking", "to": "/notebook/log", "drop": ["view"] },
    { "from": "/tracking", "query": { "view": "backups" }, "to": "/notebook/backups", "drop": ["view"] },
    { "from": "/tracking", "query": { "view": "archive" }, "to": "/notebook/backups", "drop": ["view"], "set": { "show": "campaigns" } },
    { "from": "/tracking", "query": { "view": "sandboxes" }, "to": "/notebook/sandboxes", "drop": ["view"] },
    { "from": "/tracking", "query": { "view": "jobs", "jcamp": "*" }, "to": "/runs/history", "drop": ["view"], "rename": { "jcamp": "campaign" } },
    { "from": "/tracking", "query": { "view": "jobs" }, "to": "/runs/history", "drop": ["view"], "set": { "campaign": "current" } },
    { "from": "/tracking", "to": "/notebook/log", "drop": ["view"] }
  ],
  "redirects": {
    "/app": "/",
    "/inference": "/sky/targets",
    "/sky/experiments": "/sky/compare",
    "/ensemble": "/models/starfull/leaderboard",
    "/models": "/models/starfull/leaderboard",
    "/training": "/models/starfull/leaderboard",
    "/train-members": "/models/starfull/train",
    "/realism": "/synthetic/status",
    "/realism/overview": "/synthetic/status",
    "/realism/noise": "/synthetic/noise",
    "/noise": "/synthetic/noise",
    "/galaxy-distributions": "/synthetic/galaxies",
    "/star-distribution": "/synthetic/stars",
    "/data": "/synthetic/records",
    "/data/records": "/synthetic/records",
    "/visualization": "/figures/plates",
    "/figures/grid": "/figures/sheet",
    "/inspect": "/files",
    "/ops": "/runs/live",
    "/ops/jobs": "/runs/live",
    "/ops/git": "/system/code",
    "/git": "/system/code",
    "/ops/provenance": "/system/lineage",
    "/settings": "/system/connections",
    "/settings/config": "/system/config",
    "/config": "/system/config",
    "/settings/connections": "/system/connections",
    "/connection-error": "/system/connections",
    "/settings/appearance": "/system/appearance",
    "/settings/about": "/system/code"
  }
}
