{
  "name": "euclid-polish-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EuclidPolish web console — React + Vite + TypeScript SPA served by Flask (light default, dark + system themes).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.3",
    "@tanstack/react-virtual": "3.14.13",
    "aladin-lite": "3.8.2",
    "cmdk": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.13.3",
    "react-router-dom": "6.30.4",
    "sonner": "2.0.8",
    "tinykeys": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
